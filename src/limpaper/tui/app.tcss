/* limpaper TUI — dark, calm, one accent colour */

Screen {
    background: #0f1117;
    color: #d7dae0;
}

#top {
    height: 5;
    padding: 1 2 0 2;
    background: #0f1117;
}

#logo {
    width: 26;
    color: #5fd7ff;
    text-style: bold;
}

#now {
    padding: 0 0 0 2;
    height: 3;
}

#now-playing { height: 1; margin-top: 1; }
#now-path { height: 1; }

#body {
    height: 1fr;
    padding: 0 1;
}

#sidebar {
    width: 30;
    height: 100%;
    border: round #2a2f3a;
    border-title-color: #5fd7ff;
    padding: 0 1;
    background: #141821;
}

#sidebar:focus-within { border: round #5fd7ff; }

.section {
    color: #7a8394;
    text-style: bold;
    padding: 1 0 0 1;
}

#categories {
    background: transparent;
    height: 1fr;
    margin-top: 1;
}

#categories > ListItem {
    background: transparent;
    padding: 0 1;
}

#categories > ListItem.first-category {
    border-top: dashed #2a2f3a;
    margin-top: 1;
}

#categories > ListItem.-highlight {
    background: #233041;
    color: #ffffff;
}

#categories:focus > ListItem.-highlight {
    background: #2b5b7a;
}

#main {
    height: 100%;
    padding-left: 1;
}

#filter, #online-search {
    border: round #2a2f3a;
    background: #141821;
    margin-bottom: 0;
}

#filter:focus, #online-search:focus { border: round #5fd7ff; }

DataTable {
    height: 1fr;
    border: round #2a2f3a;
    background: #141821;
    scrollbar-size-vertical: 1;
}

DataTable:focus { border: round #5fd7ff; }

DataTable > .datatable--header {
    background: #141821;
    color: #7a8394;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #2b5b7a;
    color: #ffffff;
}

DataTable > .datatable--even-row { background: #161b25; }

#message {
    height: 1;
    padding: 0 1;
    color: #a0a8b8;
}

Footer { background: #141821; }

/* ── Online ─────────────────────────────────────────────────────────── */
#online-warning {
    background: #3a2a05;
    color: #ffcf5c;
    border: tall #d9a400;
    padding: 0 2;
    margin: 1 1 0 1;
}

#source-tabs { margin: 0 1; }

OnlineScreen #online-search, OnlineScreen DataTable { margin: 0 1; }

#online-status-bar {
    height: 1;
    padding: 0 2;
}

#online-status { width: 1fr; }
#online-progress { width: 40; }

/* ── Dialogs ────────────────────────────────────────────────────────── */
ModalScreen {
    align: center middle;
    background: #000000 60%;
}

.dialog {
    width: 72;
    height: auto;
    max-height: 80%;
    padding: 1 2;
    border: round #5fd7ff;
    background: #141821;
}

.dialog.warning { border: round #d9a400; }
.dialog.warning .dialog-body { color: #ffcf5c; }

.dialog-title {
    text-style: bold;
    margin-bottom: 1;
}

.dialog-body { margin-bottom: 1; }

.dialog-buttons {
    height: auto;
    align-horizontal: right;
    margin-top: 1;
}

.dialog-buttons Button { margin-left: 2; }

#choices { height: auto; max-height: 16; background: transparent; }
